{
  "name": "ppfc-portal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "tsx --env-file=.env node_modules/.bin/vitest run",
    "test:watch": "tsx --env-file=.env node_modules/.bin/vitest",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:migrate:test": "tsx --env-file=.env scripts/migrate.ts --test",
    "data:generate": "tsx --env-file=.env scripts/generate-data.ts",
    "db:import": "tsx --env-file=.env scripts/import-csv.ts",
    "db:import:test": "tsx --env-file=.env scripts/import-csv.ts --test",
    "db:reset": "npm run db:migrate && npm run db:import",
    "test:coverage": "tsx --env-file=.env node_modules/.bin/vitest run --coverage --coverage.provider=v8",
    "routes:check": "tsx scripts/routes-check.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}
